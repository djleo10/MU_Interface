function mainGUI()
    %% Global Variable Declaration
    global cv_manual recruitment_force derecruitment_force cv_auto cv_final;
    global SIG MUPulses MUIDs ref_signal force time;
    global fsamp singleDiffCheckbox dataPath;
    global p2pResults maxP2pResults avgP2pResults minP2pResults rmsResults MU_ID;
    global MUAPs MUAPp2p MUAPrms;

    %% Initialization
    cv_manual = {}; 
    recruitment_force = {}; 
    derecruitment_force = {}; 
    cv_auto = {}; 
    cv_final = {};
    MUAPs = {}; 
    MU_ID = {}; 
    p2pResults = {}; 
    maxP2pResults = []; 
    avgP2pResults = []; 
    minP2pResults = []; 
    rmsResults = {}; 
    MUAPp2p = {}; 
    MUAPrms = {};
    SIG = [];
    MUPulses = [];
    MUIDs = [];
    ref_signal = [];
    force = [];
    time = [];
    dataPath = 'C:\Data\Demuse Data\Luigi\SMA03\W3_20230608\Decomposition Output\';
    fsamp = 4000;

    %% Main Window for Inputs
    mainWindow = figure('Name', 'Motor Unit GUI - Neuromechatronics Lab', 'Position', [100, 100, 975, 500], 'Color', [0.94 0.94 0.94]);

